# Public entry point for Azure. Build from the repo root:
#   az acr build -r <registry> -t icecream-gateway:<tag> -f deploy/azure/Dockerfile.gateway deploy/azure
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1/health/live > /dev/null || exit 1
