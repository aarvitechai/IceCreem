# Copy to .env and change every value. Never commit .env.

# SQL Server sa password: 8+ chars with upper, lower, number and symbol.
DB_PASSWORD=Change_Me_Strong#2026

# JWT signing key: at least 32 random characters. Generate with: openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-secret-of-at-least-32-chars

# Password for the demo users created on first start. Leave empty in production to skip demo data.
SEED_PASSWORD=Admin@123

# Show demo login buttons on the login page (true only for test or staging).
SHOW_DEMO_LOGINS=true

# Expose API docs at /scalar/v1 (true only for test or staging).
API_DOCS=false

# Port on the host for Nginx.
HTTP_PORT=8080
