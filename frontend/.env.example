# Copy to .env.local and adjust.
# URL of the .NET API, used by server rendering and rewrites.
API_INTERNAL_URL=http://localhost:5080
# Public address of this site (sitemap, canonical links, share previews).
NEXT_PUBLIC_SITE_URL=https://desiredicecream.redstarvibe.com
# true on test sites so search engines skip them.
NEXT_PUBLIC_NOINDEX=false
# Show demo login buttons on the login page. Keep false in production.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=false
